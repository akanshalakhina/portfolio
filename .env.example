# ✉️ Web3Forms Integration (For Contact Form forwarding)
# Get a free key at: https://web3forms.com/
WEB3FORMS_ACCESS_KEY=517baaf5-6b9d-4810-9de8-76db574f64d8

# 🐙 GitHub API Personal Access Token (Optional, to prevent rate limit limits)
# Create one at: https://github.com/settings/tokens
GITHUB_PAT=your_github_personal_access_token

# 🤖 Gemini (optional) — powers the "Ask my AI twin" chat. Without a key it answers from a built-in knowledge base.
# Get one at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# 🌐 Your deployed URL (optional) — used for link previews on LinkedIn/X
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app
